# Chave da YouTube Data API v3 (Google Cloud Console) — usada só pela Vercel
# Function em api/youtube.ts. NUNCA prefixar com VITE_: isso a embutiria no
# bundle do navegador, expondo-a publicamente. Configurar como variável de
# ambiente do servidor (Vercel: Project Settings > Environment Variables).
YOUTUBE_API_KEY=

# ID de cliente OAuth 2.0 (tipo "Aplicativo da Web"), mesmo projeto do Google Cloud.
# Origem JavaScript autorizada precisa ser o domínio de producao. Também é
# lido no servidor (api/auth/google-login.ts e google-callback.ts) — não tem
# problema não ter prefixo VITE_ nesse caso: um Client ID não é secreto.
VITE_GOOGLE_CLIENT_ID=

# Client Secret do mesmo cliente OAuth 2.0 acima (Google Cloud Console >
# Credenciais > clique no cliente > "Chaves secretas do cliente"). Usado só
# pelas Vercel Functions em api/auth/*.ts e api/youtube-authed.ts para trocar
# o "code" do login por um refresh_token de longa duração — é o que permite
# a conta continuar conectada sem pedir login de novo a cada reload/update do
# PWA. NUNCA prefixar com VITE_ (isso o exporia no bundle do navegador).
GOOGLE_CLIENT_SECRET=

# Chave da API da Anthropic (console.anthropic.com) — usada só pela Vercel
# Function em api/search-expand.ts (busca inteligente, item 4). NUNCA prefixar
# com VITE_: qualquer variável VITE_ é embutida no bundle do navegador, o que
# exporia a chave publicamente. Configurar como variável de ambiente do
# servidor (Vercel: Project Settings > Environment Variables).
ANTHROPIC_API_KEY=

# Firebase Configuration (para sincronização de progresso de vídeo no Firestore)
# Configure no Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
